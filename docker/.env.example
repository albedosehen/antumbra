# Copy to docker/.env (which is gitignored) and fill in. Compose reads it.

# SurrealDB root login (the server's own credentials; antumbra-mcp signs in per
# request as each tenant on top of this).
SURREAL_PASS=change-me-to-a-strong-password

# HS256 secret antumbra-mcp verifies request JWTs with. Generate 32 random bytes,
# base64, e.g. (PowerShell):
#   [Convert]::ToBase64String((1..32 | % {Get-Random -Max 256}))
ANTUMBRA_JWT_SECRET=change-me-base64-32-bytes

# Absolute HOST directory for SurrealDB's data (kept outside the repo). On
# Windows use forward slashes. On a Linux host this directory must be owned by
# uid 65532 (`sudo chown -R 65532:65532 <dir>`), since the container is non-root.
# Windows example: C:/Users/<you>/.antumbra/surrealdb
ANTUMBRA_SURREAL_DATA=/srv/antumbra/surrealdb

# Host embeddings endpoint (OpenAI-compatible). Must return 384-dim vectors to
# match the store's EMBED_DIM (ollama: `ollama pull all-minilm`).
ANTUMBRA_EMBEDDER_URL=http://host.docker.internal:11434/v1/embeddings
ANTUMBRA_EMBEDDER_MODEL=all-minilm

# --- antumbra-control-server (optional hosted signup) ----------------------
# Secret signing the short-lived magic-link tokens (distinct from the RS256
# issuer key below). Generate 32 random bytes, base64: `openssl rand -base64 32`.
# The server REFUSES to start on this placeholder (or anything under 32 chars).
ANTUMBRA_MAGIC_SECRET=change-me-base64-32-bytes
# External URL the emailed magic links point back to (this control server).
ANTUMBRA_CONTROL_BASE_URL=http://127.0.0.1:8090
# Least-privilege database access (recommended): a DEFINE USER ... ON DATABASE
# user instead of instance root, so a control-plane compromise is contained to
# the one database. One-time DDL in docker/README.md; leave these unset to fall
# back to instance root for a quick local bring-up.
# ANTUMBRA_CONTROL_DB_USER=antumbra_control
# ANTUMBRA_CONTROL_DB_PASS=...
# ANTUMBRA_CONTROL_DB_AUTH=database
# The RS256 issuer keypair is mounted from docker/keys/ (gitignored), not env.
# Generate it once:
#   openssl genrsa -out docker/keys/control-signing.pem 2048
#   openssl rsa -in docker/keys/control-signing.pem -pubout \
#     -out docker/keys/control-signing.pub.pem
# Real email (optional): set these to deliver magic links over SMTP; unset =
# dev mailer (link logged to the container's stderr).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=...
# SMTP_FROM=Antumbra <no-reply@example.com>
