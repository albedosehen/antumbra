# antumbra-mcp, GPU build (serving + autonomous consolidation).
#
# Builds with `--features models,cuda`, so this server can serve experts through
# the `answer` tool AND auto-graduate memory into private experts on the GPU
# (`--auto-consolidate`). The default docker/Dockerfile stays the light,
# memory-only server for hosts without an NVIDIA GPU.
#
# Run via the GPU compose override (it requests the GPU and enables the
# trigger): `docker compose -f docker/docker-compose.yml -f docker/docker-compose.gpu.yml up -d`,
# adding `-f docker/docker-compose.gpu-cdi.yml` last on a CDI host (NixOS, or
# any daemon without a named nvidia runtime). Needs the NVIDIA Container
# Toolkit on the host (Linux, or Windows via WSL2).
#
# Validated on a Linux GPU host (NixOS, CDI, RTX 3090 Ti; EXP-022): the image
# builds, downloads the base on first use, trains, and serves. It is still not
# built in CI, which has no GPU; the `gpu-test` target below is what runs the
# GPU-gated tests (`just test-gpu`). On Linux nvcc uses gcc as its host compiler,
# so the Windows `cl.exe`/CUDA-13.3 toolchain dance does not apply.

# --- build stage: CUDA devel (nvcc + gcc) + pinned rust --------------------
# CUDA 12.6 maps to cudarc's `cuda-12060`, so no CUDARC_CUDA_VERSION override is
# needed (unlike a 13.3 host toolkit). The host driver must be new enough for it.
FROM nvidia/cuda:12.6.3-devel-ubuntu24.04 AS builder
WORKDIR /build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates pkg-config build-essential \
    && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.96.0
ENV PATH="/root/.cargo/bin:${PATH}"
COPY . .
# CUDA_COMPUTE_CAP targets the GPU arch (86 = Ampere / RTX 30-series). Override
# for your card at build time -- `--build-arg CUDA_COMPUTE_CAP=89` (Ada/40-series)
# or via the compose build `args:` -- so candle builds the matching SASS.
ARG CUDA_COMPUTE_CAP=86
ENV CUDA_COMPUTE_CAP=${CUDA_COMPUTE_CAP}
# BuildKit cache mounts: crate downloads and compiled artifacts persist across
# builds, so a rebuild -- or a build interrupted by host sleep -- resumes in
# minutes instead of recompiling candle + the CUDA kernels from scratch. The
# binary is copied OUT of the cache-mounted target before the stage ends, since
# a cache mount is not part of the image layer the runtime stage COPYs from.
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/build/target \
    cargo build --release -p antumbra-mcp --locked --features models,cuda \
    && cp /build/target/release/antumbra-mcp /build/antumbra-mcp

# --- gpu-test stage: the GPU-gated tests (`--target gpu-test`) --------------
# CI has no GPU, so the tests that close the consolidation loop are `#[ignore]`d
# there and nothing else exercises them. This stage compiles the server's test
# binary with the same features, the same release profile, and the same cache
# mounts as the build above, so it reuses the compiled CUDA kernels. Building it
# needs no GPU; running it does:
#
#   docker build -f docker/Dockerfile.cuda --target gpu-test -t antumbra-gpu-test .
#   docker run --rm --device nvidia.com/gpu=all -v antumbra-gpu-test-weights:/weights antumbra-gpu-test
#
# (`--gpus all` in place of `--device` on a daemon with a named nvidia runtime.)
# It runs as the server's uid against its own weights volume, so it cannot leave
# files the server is unable to write beside.
FROM builder AS gpu-test
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 \
    && ln -sf /usr/bin/python3 /usr/local/bin/python \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -u 65532 -m -s /usr/sbin/nologin nonroot
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/build/target \
    cargo test --release -p antumbra-mcp --locked --features models,cuda --no-run \
    && cp "$(ls -t /build/target/release/deps/antumbra_mcp-* | grep -v '\.d$' | head -1)" /usr/local/bin/antumbra-mcp-tests
ENV HF_HOME=/weights
WORKDIR /gpu-test
RUN mkdir -p /weights /gpu-test && chown 65532:65532 /weights /gpu-test
USER 65532
# Everything in the binary, the ignored GPU tests included, one at a time: two
# trains at once would contend for the card and the weight download.
ENTRYPOINT ["/usr/local/bin/antumbra-mcp-tests", "--include-ignored", "--test-threads=1"]

# --- d2-probe stage: ADR-0024's D-2 measurement on the card -----------------
# The head itself is small; the ENCODER passes in front of it are not, and the
# chunked pairing multiplies them, because MiniLM pads a batch to a fixed shape
# and a 300-character chunk costs nearly what a 4000-character memory costs. An
# 800-pair three-way run did not finish in 161 minutes on CPU, so the recorded
# figures came from a 120-pair sample and had to be read as an ordering rather
# than compared to the 0.782 bar, which was measured on 800.
#
# This stage exists to remove that excuse. Build needs no GPU; running does, and
# it needs the labels, which are built from the store by scripts/d2-labels.sh:
#
#   ssh <store-host> 'bash -s' < scripts/d2-labels.sh > d2-labels.json
#   docker build -f docker/Dockerfile.cuda --target d2-probe -t antumbra-d2 .
#   docker run --rm --device nvidia.com/gpu=all \
#     -v antumbra-gpu-test-weights:/weights \
#     -v "$PWD/d2-labels.json:/labels/d2-labels.json:ro" antumbra-d2
#
# Shares the weights volume with `gpu-test` so the encoder is downloaded once.
FROM builder AS d2-probe
RUN useradd -u 65532 -m -s /usr/sbin/nologin nonroot
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/build/target \
    cargo test --release -p antumbra-serve --locked --features models,cuda --lib --no-run \
    && cp "$(ls -t /build/target/release/deps/antumbra_serve-* | grep -v '\.d$' | head -1)" /usr/local/bin/antumbra-d2
ENV HF_HOME=/weights
ENV ANTUMBRA_D2_LABELS=/labels/d2-labels.json
WORKDIR /d2
RUN mkdir -p /weights /labels /d2 && chown 65532:65532 /weights /d2
USER 65532
# One at a time: two encoder passes at once would contend for the card.
ENTRYPOINT ["/usr/local/bin/antumbra-d2", "--ignored", "--nocapture", "--test-threads=1", "d2_head"]

# --- runtime stage: CUDA runtime + python (the exec verifier) --------------
FROM nvidia/cuda:12.6.3-runtime-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive
# `python` is the consolidation/capture verifier (marker checks run as a subprocess).
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 ca-certificates \
    && ln -sf /usr/bin/python3 /usr/local/bin/python \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -u 65532 -m -s /usr/sbin/nologin nonroot
COPY --from=builder /build/antumbra-mcp /usr/local/bin/antumbra-mcp
# Base weights (Qwen2.5-Coder-1.5B) download here on first train; persist via a
# volume. Trained adapters land under /adapters (the server's working dir).
ENV HF_HOME=/weights
WORKDIR /adapters
RUN mkdir -p /weights /adapters && chown 65532:65532 /weights /adapters
USER 65532
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/antumbra-mcp"]
