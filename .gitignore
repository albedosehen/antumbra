# Ignore by default
/*

# Whitelist project files and directories
!/.gitattributes
!/.github/
!/.gitignore
!/Cargo.toml
!/Cargo.lock
!/LICENSE
!/README.md
!/corpora/
!/crates/
!/docs/
!/experiments/
!/scripts/
!/rust-toolchain.toml
!/justfile
!/dist-workspace.toml
!/dprint.json
!/.dockerignore
!/docker/
# The audit triage and the fetch config, not the whole directory. audit.toml
# would otherwise be swallowed by the deny-by-default `/*` above, and CI would
# audit with a config that only exists on someone's laptop. config.toml became
# workspace state (no longer machine state) when oneiriq-janus arrived: a
# private git dependency fetched over ssh needs `git-fetch-with-cli`, which
# every clone must carry or the build fails at fetch.
!/.cargo/
/.cargo/*
!/.cargo/audit.toml
!/.cargo/config.toml

# Explicit Ignore
**/.env
# Control-plane signing keys (RS256 PEMs) are deployment secrets, never committed.
/docker/keys/
# Generated artifacts anywhere inside allowlisted directories.
**/*.rs.bk
Cargo.lock.bak
*.gguf
*.safetensors
*.surql.db
*.db
# memory-import / compose scratch outputs (corpora/_imported.json, etc.).
corpora/_*.json

# Local-only directories (also covered by `/*`, kept explicit for intent).
/target/
/data/
/weights/
/adapters/

# Docker build logs (artifacts)
docker/*.log
