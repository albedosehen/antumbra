# Ignore by default
/*

# Whitelist project files and directories
!/.gitattributes
!/.github/
!/.gitignore
!/Cargo.toml
!/Cargo.lock
!/LICENSE
!/README.md
!/corpora/
!/crates/
!/docs/
!/experiments/
!/scripts/
!/rust-toolchain.toml
!/justfile
!/dist-workspace.toml
!/dprint.json
!/.dockerignore
!/docker/
# The audit triage only, not the whole directory: a local .cargo/config.toml is
# machine state and must not ride along. Without this, .cargo/audit.toml is
# swallowed by the deny-by-default `/*` above and CI audits with a config that
# only exists on someone's laptop.
!/.cargo/
/.cargo/*
!/.cargo/audit.toml

# Explicit Ignore
**/.env
# Control-plane signing keys (RS256 PEMs) are deployment secrets, never committed.
/docker/keys/
# Generated artifacts anywhere inside allowlisted directories.
**/*.rs.bk
Cargo.lock.bak
*.gguf
*.safetensors
*.surql.db
*.db
# memory-import / compose scratch outputs (corpora/_imported.json, etc.).
corpora/_*.json

# Local-only directories (also covered by `/*`, kept explicit for intent).
/target/
/data/
/weights/
/adapters/

# Docker build logs (artifacts)
docker/*.log
