# Ignore by default
/*

# Whitelist project files and directories
!/.gitattributes
!/.github/
!/.gitignore
!/Cargo.toml
!/Cargo.lock
!/LICENSE
!/README.md
!/corpora/
!/crates/
!/docs/
!/experiments/
!/scripts/
!/rust-toolchain.toml
!/justfile
!/dist-workspace.toml
!/dprint.json

# Explicit Ignore
# Generated artifacts anywhere inside allowlisted directories.
**/*.rs.bk
Cargo.lock.bak
*.gguf
*.safetensors
*.surql.db
*.db
# memory-import / compose scratch outputs (corpora/_imported.json, etc.).
corpora/_*.json

# Local-only directories (also covered by `/*`, kept explicit for intent).
/target/
/data/
/weights/
/adapters/
