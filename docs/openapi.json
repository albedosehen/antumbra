    "/v1/compartments": {
      "get": {
        "operationId": "list_compartments",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 100,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Opaque cursor from a previous page's next_cursor.",
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter by owner (indexed).",
            "in": "query",
            "name": "owner",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Sort order; every value is backed by an index.",
            "in": "query",
            "name": "sort",
            "schema": {
              "enum": [
                "updated_at",
                "-updated_at"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompartmentPage"
                }
              }
            },
            "description": "Page of resources."
          }
        }
      }
    },
